{
  "manifest_version": 3,
  "name": "Binance Chart Predictor",
  "description": "Render Binance Spot OHLC charts and run local browser inference.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/binance-16.png",
    "32": "icons/binance-32.png",
    "48": "icons/binance-48.png",
    "128": "icons/binance-128.png"
  },
  "action": {
    "default_title": "Open Chart Predictor Panel",
    "default_icon": {
      "16": "icons/binance-16.png",
      "32": "icons/binance-32.png",
      "48": "icons/binance-48.png",
      "128": "icons/binance-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "tabs", "cookies", "alarms"],
  "host_permissions": ["https://api.binance.com/*", "<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["models/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
